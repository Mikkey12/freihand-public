<Project>
  <!-- Paketversionen zentral; nur freizügige Lizenzen -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio und Erkennung (P8) sowie Machbarkeitstest (tools/Freihand.Benchmark) -->
    <PackageVersion Include="NAudio.Core" Version="3.1.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageVersion Include="NAudio.WinMM" Version="3.1.0" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />

    <!-- Korrigieren und Glätten im Diktatfenster über die Claude-API (Beta, B8); offizielles SDK, MIT -->
    <PackageVersion Include="Anthropic" Version="13.7.0" />

    <!-- Windows-Aufrufe der Windows-Schicht (P7, Technikentscheid) -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
