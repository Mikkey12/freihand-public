<Window x:Class="Freihand.App.LearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freihand – Wort lernen"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">
  <!-- Wort lernen (P11 S4): Schreibweise tippen, Wort sprechen, Gehörtes als Ersetzung speichern; alles lokal -->
  <StackPanel Margin="16">
    <TextBlock TextWrapping="Wrap"
               Text="1. Tippe die richtige Schreibweise. 2. Klicke auf „Sprechen“ und lies die drei Sätze darunter vor, mit einer kurzen Pause nach jedem Satz. 3. Klicke auf „Fertig“, wähle aus, was Freihand ersetzen soll, und speichere." />
    <TextBlock Text="Richtige Schreibweise" Margin="0,12,0,4" />
    <TextBox x:Name="SpellingBox" AutomationProperties.Name="Richtige Schreibweise" MaxLength="100" TextChanged="OnSpellingChanged" />
    <TextBlock x:Name="Sentences" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="15" />
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="ListenButton" Content="_Sprechen" MinWidth="110" Padding="10,2" Click="OnListen" />
      <TextBlock x:Name="Heard" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
    </StackPanel>
    <TextBlock Text="Gehört – angekreuzt wird ersetzt" Margin="0,14,0,4" />
    <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" MinHeight="60" Padding="6">
      <StackPanel x:Name="Candidates" />
    </Border>
    <TextBlock x:Name="State" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />
    <ScrollViewer MaxHeight="80" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="Learned" TextWrapping="Wrap" Opacity="0.7"
                 AutomationProperties.Name="Gelernte Wörter; ändern oder abschalten in woerter.txt" />
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="ResetButton" Content="_Von vorne" Padding="10,2" Click="OnReset" />
      <Button Content="Wörterliste _öffnen" Padding="10,2" Margin="8,0,0,0" Click="OnOpenList" />
      <Button x:Name="SaveButton" Content="Spei_chern" MinWidth="90" Margin="8,0,0,0" Click="OnSave" IsEnabled="False" />
      <Button x:Name="CloseButton" Content="Sch_liessen" MinWidth="90" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
