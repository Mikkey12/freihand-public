<Window x:Class="Freihand.App.FieldMeasureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freihand – Feld messen"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">
  <!-- Feld messen (Bedienregel vom 21.11.2026): vor dem Start alle Hinweise, danach das Ergebnis -->
  <StackPanel Margin="16">
    <StackPanel x:Name="Before">
      <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                 Text="Freihand misst, wie schnell es in ein Feld dieses Programms schreiben kann." />
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="1. Klicke auf „Messen starten“. Du hast dann 10 Sekunden, um in ein leeres Textfeld des Programms zu klicken. Jede Sekunde kommt ein Ton." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="2. Danach nichts mehr anfassen, bis drei Töne kommen (meist etwa eine Minute). Freihand schreibt einen Prüftext, zuerst in Stücken von 50 Zeichen und bei Fehlern in kleineren, bis die grösste fehlerfreie Grösse gefunden ist; es prüft jedes Zeichen und löscht den Text wieder. Es drückt nie Enter; abgeschickt wird nichts." />
      <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Bitte beachten" />
      <TextBlock TextWrapping="Wrap"
                 Text="• Nur in ein leeres Feld. Steht etwas darin, misst Freihand nicht." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Programme, die selbst speichern (z. B. Dynamics, CRM, Ticketsysteme, Formulare): in einem neuen Datensatz messen, den du danach nicht speicherst, oder in einem Testfeld. Sonst kann der Prüftext kurz in echten Daten stehen." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Lässt Windows das Feld nicht zurücklesen, kann Freihand nicht prüfen. Dann schreibt Freihand dort nichts, und es bleibt beim bisherigen Wert." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Das Ergebnis gilt für alle Felder, die sich bei Windows genau gleich melden. In Browsern sind das oft alle Textfelder dieser Art, auf allen Webseiten." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Freihand nimmt die grösste Stückgrösse, die dreimal fehlerfrei ankam, höchstens 50 Zeichen. Zeilenumbrüche bleiben gesperrt." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Lässt ein Programm sich nicht messen (z. B. WhatsApp): „Nur Feld erkennen“ liest nur, wie sich das Feld meldet, ohne etwas zu schreiben. Danach legst du den Wert von Hand fest und prüfst ihn beim Diktieren." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Kommt der Prüftext verändert an, löscht Freihand ihn nicht selbst. Zwei tiefe Töne heissen: Testfeld selbst leeren (Strg+A, Entf), dann wieder nichts anfassen. Die Messung geht mit einer kleineren Stufe weiter; ohne Leeren bricht sie nach 90 Sekunden ab." />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="• Ein grauer Hinweistext stört nur, wenn Windows ihn als Inhalt meldet. Dann misst Freihand nicht und tippt auch kein Zeichen hinein; nimm ein eindeutig leeres Testfeld oder „Nur Feld erkennen“." />
    </StackPanel>
    <StackPanel x:Name="After" Visibility="Collapsed">
      <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock x:Name="IdentityText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />
      <StackPanel x:Name="ManualPanel" Margin="0,12,0,0" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap"
                   Text="Wert von Hand: so viele Zeichen schreibt Freihand hier je Schritt. Danach diktieren und prüfen; fehlen Buchstaben, einen kleineren Wert wählen." />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <ComboBox x:Name="ManualBox" MinWidth="80" AutomationProperties.Name="Zeichen je Schritt" />
          <Button x:Name="ManualButton" Content="Wert _übernehmen" Margin="8,0,0,0" Padding="10,2" Click="OnManual" />
        </StackPanel>
        <TextBlock x:Name="ManualText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Gemessene Felder _öffnen" Padding="10,2" Click="OnOpenList" />
      <Button x:Name="IdentifyButton" Content="Nur Feld _erkennen" Margin="8,0,0,0" Padding="10,2" Click="OnIdentify" />
      <Button x:Name="StartButton" Content="Messen _starten" MinWidth="120" Margin="8,0,0,0" Padding="10,2" Click="OnStart" IsDefault="True" />
      <Button x:Name="CloseButton" Content="Sch_liessen" MinWidth="90" Margin="8,0,0,0" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
