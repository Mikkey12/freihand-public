<Window x:Class="Freihand.App.KeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freihand – Schlüssel für Korrigieren"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">
  <!-- Schlüssel für die Claude-API (Beta B8, SI-03): einfügen ohne Tippen, gespeichert mit DPAPI, nie angezeigt -->
  <StackPanel Margin="16">
    <TextBlock TextWrapping="Wrap"
               Text="Kopiere den API-Schlüssel in der Anthropic Console (Knopf zum Kopieren neben dem neuen Schlüssel) und klicke dann auf „Aus der Zwischenablage einfügen“. Der Schlüssel wird verschlüsselt gespeichert und nie angezeigt." />
    <PasswordBox x:Name="KeyBox" Margin="0,12,0,0" AutomationProperties.Name="API-Schlüssel" />
    <TextBlock x:Name="State" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Aus der _Zwischenablage einfügen" Padding="10,2" Click="OnPaste" />
      <Button Content="_Speichern" MinWidth="90" Margin="8,0,0,0" Click="OnSave" IsDefault="True" />
      <Button Content="_Löschen" MinWidth="90" Margin="8,0,0,0" Click="OnDelete" />
      <Button x:Name="CloseButton" Content="S_chliessen" MinWidth="90" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
